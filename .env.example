# Copy to ".env" in this folder, then paste your project values from:
# Supabase Dashboard → Project Settings → API → Project URL & anon public key
# Names must stay VITE_* so Vite exposes them to the browser. Restart dev server after changes.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: lightweight client-side prompt before the app loads (leave empty to disable gate locally).
# Do not treat this as real security; VITE_* values are visible in the browser bundle.
# On GitHub Pages, set the same name in Actions secrets for the build step.
VITE_SITE_PASSWORD=
